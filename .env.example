# Django
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev

# Database
DATABASE_URL=sqlite:///db.sqlite3

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# JWT
JWT_SIGNING_KEY=change-me-in-production-use-different-from-secret-key
JWT_ACCESS_LIFETIME=30
JWT_REFRESH_LIFETIME=7

# Production
ALLOWED_HOSTS=api.mashop.cd
CORS_ALLOWED_ORIGINS=https://mashop.cd,https://admin.mashop.cd

# Email (production)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@mashop.cd
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=noreply@mashop.cd